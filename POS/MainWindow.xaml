<Window x:Class="POS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="POS ERP"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        Background="#F3F5F7"
        FlowDirection="RightToLeft"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E8EEF5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter Margin="4,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2B4056"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#172433">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Padding="18,22" BorderBrush="#2B4056" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="{Binding StoreName}" Foreground="White" FontSize="23" FontWeight="Bold"/>
                        <TextBlock Text="نظام إدارة المبيعات والمخزون" Foreground="#9FB2C5" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12">
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding DashboardCommand}" Content="الرئيسية"/>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding POSCommand}" Content="نقطة البيع"/>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding SalesCommand}" Content="المبيعات"/>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding PurchaseCommand}" Content="المشتريات"/>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding InventoryCommand}" Content="الأصناف والمخزون"/>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding MovingProductsCommand}" Content="تحويل المخزون"/>
                        <Separator Margin="16,10" Background="#34485D"/>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding CustomersCommand}" Content="العملاء"/>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding SuppliersCommand}" Content="الموردون"/>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding QuotationsCommand}" Content="عروض الأسعار"/>
                        <Separator Margin="16,10" Background="#34485D"/>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding UsersCommand}" Content="المستخدمون"/>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding RolesCommand}" Content="الصلاحيات"/>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding CompanyCommand}" Content="الإعدادات وبيانات الشركة"/>
                        <Button Style="{StaticResource NavButtonStyle}" Command="{Binding ManufacturingCommand}" Content="التصنيع"/>
                    </StackPanel>
                </ScrollViewer>

                <Border DockPanel.Dock="Bottom" Padding="12" BorderBrush="#2B4056" BorderThickness="0,1,0,0">
                    <TextBlock Text="POS ERP" Foreground="#7F93A8" HorizontalAlignment="Center" FontSize="11"/>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#DDE2E7" BorderThickness="0,0,0,1">
                <Grid Margin="22,0">
                    <TextBlock Text="{Binding PageTitle}" VerticalAlignment="Center" FontSize="22" FontWeight="SemiBold" Foreground="#263544"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Content="—" Width="38" Height="32" Margin="4" Click="MinimizeButton_Click" Background="Transparent" BorderThickness="0" FontSize="18"/>
                        <Button Content="×" Width="38" Height="32" Margin="4" Click="CloseButton_Click" Background="Transparent" BorderThickness="0" FontSize="20"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="14" Background="White" CornerRadius="8" BorderBrush="#DDE2E7" BorderThickness="1">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StoreName}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#263544"/>
                        <TextBlock Text="اختر إحدى الوظائف من القائمة لبدء العمل" FontSize="16" Foreground="#6B7785" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <ContentControl Content="{Binding CurrentView}" Margin="4"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
