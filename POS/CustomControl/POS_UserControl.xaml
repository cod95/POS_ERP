<UserControl x:Class="POS.CustomControl.POS_UserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="#F5F7FA">
    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1F2D3D"/><Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#52606D"/>
            <Setter Property="Margin" Value="4,4,8,4"/><Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="42"/><Setter Property="Padding" Value="18,6"/>
            <Setter Property="Margin" Value="4"/><Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="RowHeight" Value="34"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7DEE6"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#D7DEE6" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="نقطة البيع" FontSize="24" FontWeight="Bold" Foreground="#1F2D3D"/>
                    <TextBlock Text="فاتورة بيع سريعة — الباركود، الأصناف، السلة والدفع" Foreground="#6B7785" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="رقم الفاتورة" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding BillNumber}" IsReadOnly="True" Height="34" FontSize="16" FontWeight="Bold" Padding="8" HorizontalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#D7DEE6" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="BarcodeSearchBox" Grid.Column="0" Height="42" FontSize="20" Padding="10"
                         VerticalContentAlignment="Center" Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="BarcodeSearchBox_KeyDown" ToolTip="امسح الباركود ثم اضغط Enter"/>
                <Button Grid.Column="1" Content="بحث بالباركود" Style="{StaticResource ActionButton}" Click="SearchBarcode_Click"/>
                <Button Grid.Column="2" Content="إضافة للسلة" Background="#1F7A4D" Foreground="White" Style="{StaticResource ActionButton}" Command="{Binding AcceptCommand}"/>
                <Button Grid.Column="3" Content="مسح" Style="{StaticResource ActionButton}" Click="ClearSelection_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1.85*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#D7DEE6" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="الأصناف" Style="{StaticResource SectionHeader}"/>
                    <DataGrid Grid.Row="1" Style="{StaticResource DataGridStyle}" ItemsSource="{Binding ProductList}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الصنف" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="*"/>
                            <DataGridTextColumn Header="السعر" Binding="{Binding SalePrice, StringFormat={}{0:0.00}}" Width="*"/>
                            <DataGridTextColumn Header="المتوفر" Binding="{Binding Quantity}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="الكمية" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="1" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="7"/>
                        <TextBlock Grid.Column="2" Text="السعر" Style="{StaticResource FieldLabel}"/>
                        <TextBox Grid.Column="3" Text="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="7"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="#D7DEE6" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="سلة الفاتورة" Style="{StaticResource SectionHeader}"/>
                    <DataGrid Grid.Row="1" Style="{StaticResource DataGridStyle}" ItemsSource="{Binding CartItemsList}" SelectedItem="{Binding SelectedCartItem}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الصنف" Binding="{Binding Product.Name}" Width="2*"/>
                            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="*"/>
                            <DataGridTextColumn Header="سعر البيع" Binding="{Binding SalePrice, StringFormat={}{0:0.00}}" Width="*"/>
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding SalePrice, StringFormat={}{0:0.00}}" Width="*"/>
                            <DataGridTextColumn Header="ملاحظات" Binding="{Binding Details}" Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="White" BorderBrush="#D7DEE6" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="العميل:" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Width="170" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name"/>
                    <TextBlock Text="المخزن:" Style="{StaticResource FieldLabel}" Margin="18,4,8,4"/>
                    <ComboBox Width="170" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}" DisplayMemberPath="Name"/>
                </StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="المجموع الفرعي" Foreground="#52606D"/><TextBlock Text="{Binding SubTotal, StringFormat={}{0:0.00}}" FontSize="19" FontWeight="Bold"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="الضريبة" Foreground="#52606D"/><TextBlock Text="{Binding Tax, StringFormat={}{0:0.##}}" FontSize="19" FontWeight="Bold"/></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="الخصم" Foreground="#52606D"/><TextBlock Text="{Binding Discount, StringFormat={}{0:0.00}}" FontSize="19" FontWeight="Bold"/></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="الإجمالي" Foreground="#1F2D3D"/><Button Content="{Binding TotalAmount, StringFormat=دفع — {0:0.00}}" Height="48" Background="#166534" Foreground="White" FontSize="19" FontWeight="Bold" Command="{Binding PaymentCommand}"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>