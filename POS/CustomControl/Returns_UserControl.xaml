<UserControl x:Class="POS.CustomControl.Returns_UserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="#F6F7F9"
             MinWidth="1000"
             MinHeight="650">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="مرتجعات المبيعات والمشتريات" FontSize="26" FontWeight="SemiBold" Foreground="#20252B"/>
            <TextBlock Text="إرجاع الأصناف من الفاتورة الأصلية مع تحديث المخزون وتسجيل المستند" FontSize="13" Foreground="Gray" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#D9DEE5" BorderThickness="1" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="نوع الإرجاع" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding ReturnTypeOptions}" SelectedItem="{Binding SelectedReturnType}" Height="36"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="رقم الفاتورة" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding SourceNumber, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                    <TextBlock Text="المستودع" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}" DisplayMemberPath="Name" Height="36"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="16,0,0,0">
                    <TextBlock Text="سبب الإرجاع" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="8"/>
                </StackPanel>

                <Button Grid.Column="4" Content="تحميل الفاتورة" Command="{Binding LoadDocumentCommand}" Background="#007ACC" Foreground="White" Height="36" VerticalAlignment="Bottom" Margin="16,0,0,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#D9DEE5" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" IsReadOnly="True" Width="4*"/>
                    <DataGridTextColumn Header="الكمية الأصلية" Binding="{Binding OriginalQuantity}" IsReadOnly="True" Width="2*"/>
                    <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat=N2}" IsReadOnly="True" Width="2*"/>
                    <DataGridTextColumn Header="كمية الإرجاع" Binding="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
            <Button Content="تنفيذ الإرجاع" Command="{Binding CreateReturnCommand}" Background="#007ACC" Foreground="White" FontWeight="SemiBold" Padding="24,10"/>
        </StackPanel>
    </Grid>
</UserControl>
