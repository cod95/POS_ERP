<UserControl x:Class="POS.CustomControl.CurrencyRates_UserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="#F6F7F9"
             MinWidth="900"
             MinHeight="650">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="العملات وأسعار الصرف" FontSize="26" FontWeight="SemiBold" Foreground="#20252B"/>
            <TextBlock Text="إدارة سعر صرف الدولار مقابل الليرة مع الاحتفاظ بالسعر التاريخي للفواتير" FontSize="13" Foreground="Gray" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#D9DEE5" BorderThickness="1" Padding="18" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="سعر 1 دولار بالليرة" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding LbpRate, UpdateSourceTrigger=PropertyChanged}" Height="38" Padding="8" FontSize="16"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="18,0,0,0">
                    <TextBlock Text="تاريخ بدء العمل" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <DatePicker SelectedDate="{Binding EffectiveDate}" Height="38"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="18,0,18,0">
                    <TextBlock Text="ملاحظات" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="38" Padding="8"/>
                </StackPanel>

                <Button Grid.Column="4" Content="حفظ السعر" Command="{Binding SaveCommand}" Background="#007ACC" Foreground="White" FontWeight="SemiBold" Height="38" VerticalAlignment="Bottom" Margin="0,0,0,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#D9DEE5" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Rates}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="العملة" Binding="{Binding Currency}" Width="*"/>
                    <DataGridTextColumn Header="السعر مقابل الدولار" Binding="{Binding Rate, StringFormat=N2}" Width="2*"/>
                    <DataGridTextColumn Header="تاريخ السريان" Binding="{Binding EffectiveDate, StringFormat=dd/MM/yyyy HH:mm}" Width="2*"/>
                    <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="3*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
