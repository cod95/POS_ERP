<UserControl x:Class="POS.CustomControl.AccountStatements_UserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="#F6F7F9"
             MinWidth="1000"
             MinHeight="650">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="حسابات العملاء والموردين" FontSize="26" FontWeight="SemiBold" Foreground="#20252B"/>
            <TextBlock Text="كشف حساب ومراجعة الفواتير والدفعات والأرصدة" FontSize="13" Foreground="Gray" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="حسابات العملاء">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="العميل" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name" Width="320" Height="36"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="White" BorderBrush="#D9DEE5" BorderThickness="1" Padding="12" Margin="0,14,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="الرصيد الحالي (USD):" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CustomerBalance, StringFormat=N2}" FontSize="18" FontWeight="Bold" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding CustomerRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="2*"/>
                            <DataGridTextColumn Header="المستند" Binding="{Binding DocumentNumber}" Width="2*"/>
                            <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="3*"/>
                            <DataGridTextColumn Header="مدين" Binding="{Binding Debit, StringFormat=N2}" Width="2*"/>
                            <DataGridTextColumn Header="دائن" Binding="{Binding Credit, StringFormat=N2}" Width="2*"/>
                            <DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat=N2}" Width="2*"/>
                            <DataGridTextColumn Header="العملة" Binding="{Binding Currency}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="حسابات الموردين">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="المورد" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name" Width="320" Height="36"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="White" BorderBrush="#D9DEE5" BorderThickness="1" Padding="12" Margin="0,14,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="الرصيد الحالي (USD):" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SupplierBalance, StringFormat=N2}" FontSize="18" FontWeight="Bold" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding SupplierRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="2*"/>
                            <DataGridTextColumn Header="المستند" Binding="{Binding DocumentNumber}" Width="2*"/>
                            <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="3*"/>
                            <DataGridTextColumn Header="مدين" Binding="{Binding Debit, StringFormat=N2}" Width="2*"/>
                            <DataGridTextColumn Header="دائن" Binding="{Binding Credit, StringFormat=N2}" Width="2*"/>
                            <DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat=N2}" Width="2*"/>
                            <DataGridTextColumn Header="العملة" Binding="{Binding Currency}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
