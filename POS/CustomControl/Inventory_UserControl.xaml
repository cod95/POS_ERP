<UserControl x:Class="POS.CustomControl.Inventory_UserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="#F5F7FA">
    <UserControl.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="14,5"/><Setter Property="Margin" Value="3"/>
            <Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#52606D"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="3,5,8,5"/><Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/><Setter Property="RowHeight" Value="34"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7DEE6"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#D7DEE6" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="الأصناف والمخزون" FontSize="24" FontWeight="Bold" Foreground="#1F2D3D"/>
                <TextBlock Text="دليل الأصناف — الباركود، التصنيف، الكلفة، سعر البيع، الكمية والمخزن" Foreground="#6B7785" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="#D7DEE6" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
            <WrapPanel>
                <Button Content="صنف جديد" Style="{StaticResource ActionButton}" Background="#166534" Foreground="White" Command="{Binding AddCommand}"/>
                <Button Content="تعديل الصنف" Style="{StaticResource ActionButton}" Command="{Binding EditCommand}"/>
                <Button Content="حذف" Style="{StaticResource ActionButton}" Command="{Binding DeleteCommand}"/>
                <Button Content="حفظ وإضافة" Style="{StaticResource ActionButton}" Background="#1D4ED8" Foreground="White" Command="{Binding SaveAndAddCommand}"/>
                <Button Content="حفظ التعديل" Style="{StaticResource ActionButton}" Background="#1D4ED8" Foreground="White" Command="{Binding SaveAndEditCommand}"/>
                <Button Content="إلغاء" Style="{StaticResource ActionButton}" Command="{Binding CancelCommand}"/>
                <Button Content="إدارة التصنيفات" Style="{StaticResource ActionButton}" Command="{Binding ManageCategoryCommand}"/>
                <Button Content="إدارة المخازن" Style="{StaticResource ActionButton}" Command="{Binding ManageWarehouseCommand}"/>
                <Button Content="توليد باركود" Style="{StaticResource ActionButton}" Command="{Binding GenerateRandomBarcodeCommand}"/>
                <Button Content="اختيار صورة" Style="{StaticResource ActionButton}" Command="{Binding ChooseImageCommand}"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#D7DEE6" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="المخزن" Style="{StaticResource LabelStyle}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}" DisplayMemberPath="Name" Height="34" Margin="4"/>
                        <TextBlock Grid.Column="2" Text="بحث الاسم" Style="{StaticResource LabelStyle}"/>
                        <TextBox Grid.Column="3" Text="{Binding ItemNameSearchText, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="7"/>
                    </Grid>
                    <DataGrid Grid.Row="1" Style="{StaticResource GridStyle}" ItemsSource="{Binding ProductsList}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="2.2*"/>
                            <DataGridTextColumn Header="التصنيف" Binding="{Binding Category.Name}" Width="1.4*"/>
                            <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="1.3*"/>
                            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="0.8*"/>
                            <DataGridTextColumn Header="سعر البيع" Binding="{Binding SalePrice, StringFormat={}{0:0.00}}" Width="1*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="#D7DEE6" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="بطاقة الصنف" FontSize="19" FontWeight="Bold" Foreground="#1F2D3D" Margin="0,0,0,12"/>
                        <TextBlock Text="اسم الصنف" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="7"/>
                        <TextBlock Text="التصنيف" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding ProductCategories}" SelectedItem="{Binding SelectedProductCategory}" DisplayMemberPath="Name" Height="34"/>
                        <TextBlock Text="الباركود" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="7"/>
                        <TextBlock Text="الوحدة" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}" Height="34"/>
                        <TextBlock Text="سعر البيع" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding RetailPrice, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="7"/>
                        <TextBlock Text="الحد الأدنى للسعر" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MinSalePrice, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="7"/>
                        <TextBlock Text="الحد الأدنى للمخزون" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding MinStock, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="7"/>
                        <TextBlock Text="الكمية الحالية" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="7"/>
                        <TextBlock Text="الوصف" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding ProductDescription, UpdateSourceTrigger=PropertyChanged}" Height="60" Padding="7" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>